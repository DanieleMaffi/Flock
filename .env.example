# Flock settings for docker-compose.yml. Copy to .env and adjust.
# Comments go on their own lines: an inline "# ..." after a value ends up inside the value.

# --- build ---
# 86 = RTX 3090, 89 = RTX 40, 120 = RTX 50
CUDA_ARCHITECTURES=86
# 0 skips the picture reader's build
BUILD_VISION=1
# the commit you build (git rev-parse HEAD)
FLOCK_COMMIT=

# --- model ---
# UD-IQ2_XXS (42 GB, every expert in VRAM on two 24 GB cards) | UD-Q3_K_XL (60 GB) | UD-Q4_K_XL (80 GB)
MODEL=UD-IQ2_XXS
MODEL_PATH=/data/Strata-data/models/ornith-ud-iq2_xxs
# 65536 keeps every UD-IQ2_XXS expert in VRAM on two 24 GB cards; 131072 runs, a little slower
CONTEXT=65536
# no | yes | cpu (pictures are off with the two-GPU split so far)
VISION=no

# --- GPUs and server ---
GPUS=0,1
PARALLEL=1
PORT=8000
# the key clients must send (16+ characters; openssl rand -hex 24). Empty: one is made on the first start.
API_KEY=
